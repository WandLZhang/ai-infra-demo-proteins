# Copy to .env and fill in. Vite bakes these into the dist/ bundle at build time
# (any value here ships to anyone who loads the deployed page), so use a Maps API
# key restricted by HTTP referrer to your frontend hostnames — see README.

# Google Maps JavaScript API key — restrict by HTTP referrer in GCP Console to
# the Cloud Run + Firebase hostnames where this frontend is served.
VITE_GOOGLE_MAPS_API_KEY=

# Public URL of the deployed state server (the Flask app in local-controller/).
# Typically the Cloud Run service URL printed by scripts/deploy_server.sh.
VITE_STATE_SERVER=
